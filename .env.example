# Node / Next.js Configuration
NODE_ENV=development
WEBSITE_PORT=3000
BACKOFFICE_PORT=3001

# FastAPI Backend Configuration
BACKEND_PORT=8000

# Inter-Service Connection URLs
# Browser client-side API target (accessed from host browser)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Internal SSR API target (accessed within Docker network by container service name)
INTERNAL_BACKEND_URL=http://backend:8000

# Application Secrets & Security Keys
SECRET_KEY=change-this-in-production-secret-key

# Queue & Celery Configuration (uncomment to override default container network resolution)
# REDIS_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# FLOWER_BASIC_AUTH=admin:admin

