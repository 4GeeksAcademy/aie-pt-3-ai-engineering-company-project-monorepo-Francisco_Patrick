# Node / Next.js Configuration
NODE_ENV=development
WEBSITE_PORT=3000
BACKOFFICE_PORT=3001

# FastAPI Backend Configuration
BACKEND_PORT=8000

# Inter-Service Connection URLs
# Browser client-side API target (accessed from host browser)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Internal SSR API target (accessed within Docker network by container service name)
INTERNAL_BACKEND_URL=http://backend:8000

# Application Secrets & Security Keys
SECRET_KEY=change-this-in-production-secret-key

# TrackFlow MCP Server Configuration (mcps/trackflow-server)
# Fail-fast security requirement: Either MCP_JWT_SECRET or MCP_OAUTH_JWKS_URI must be set
MCP_JWT_SECRET=asupersecretmpcjwtkey_min32chars_trackflow_2026
# MCP_OAUTH_JWKS_URI=https://auth.trackflow.local/.well-known/jwks.json
MCP_OAUTH_ISSUER=https://auth.trackflow.local
MCP_OAUTH_AUDIENCE=https://api.trackflow.local/mcp/
MCP_PORT=8001
MCP_HOST=0.0.0.0
MCP_TRANSPORT=sse

# Queue & Celery Configuration (uncomment to override default container network resolution)
# REDIS_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# FLOWER_BASIC_AUTH=admin:admin

