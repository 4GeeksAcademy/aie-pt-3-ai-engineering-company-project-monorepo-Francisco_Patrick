JWT_SECRET_KEY=your_jwt_secret_key_here
RESEND_API_KEY=re_123456789_example_key
PASSWORD_RESET_EXPIRE_MINUTES=30

# Dual Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trackflow_db
TINYDB_PATH=db.json

# Queue & Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
FLOWER_BASIC_AUTH=admin:admin

# AI, LLM & Agent Runtime Configuration (RAG & Knowledge Base)
LLM_API_KEY=your_llm_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
AGENT_MODEL=gemini-2.5-pro

# Embedding & Vector Store Configuration
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
USE_FASTEMBED_ONNX=false
KNOWLEDGE_SIMILARITY_THRESHOLD=0.62
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_HOST=
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=trackflow_knowledge


