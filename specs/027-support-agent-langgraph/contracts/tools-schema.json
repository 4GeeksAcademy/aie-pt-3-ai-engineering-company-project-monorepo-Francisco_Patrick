{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SupportAgentOperationalToolsSchema",
  "description": "Strict read-only input and output contracts for the Support Ticket Query Tool and Inventory Stock Query Tool (FR-016 to FR-022).",
  "$defs": {
    "ToolCallStatus": {
      "type": "string",
      "enum": ["success", "not_found", "timeout", "error"]
    },
    "TicketToolInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ticket_id": {
          "type": ["string", "null"],
          "description": "Specific incident identifier (e.g., 'INC-001' or 'inc_a1b2c3d4e5f6')."
        },
        "status": {
          "type": ["string", "null"],
          "enum": ["open", "in_progress", "resolved", "discarded", null],
          "description": "Optional lifecycle status filter."
        },
        "category": {
          "type": ["string", "null"],
          "enum": ["delay", "damage", "billing", "stock", "system", "other", null],
          "description": "Optional incident category filter."
        },
        "origin": {
          "type": ["string", "null"],
          "enum": ["customer", "warehouse", "carrier", "partner", "internal", null],
          "description": "Optional incident origin filter."
        },
        "branch": {
          "type": ["string", "null"],
          "description": "Optional branch filter (e.g., 'central', 'zaragoza', 'los_angeles')."
        },
        "limit": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 20,
          "description": "Maximum number of incident records returned into agent state (hard cap: 20)."
        }
      }
    },
    "TicketRecordDTO": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "status",
        "category",
        "origin",
        "branch",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "category": { "type": "string" },
        "origin": { "type": "string" },
        "branch": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    },
    "TicketToolOutput": {
      "type": "object",
      "required": [
        "status",
        "records",
        "total_matched",
        "latency_ms"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/ToolCallStatus" },
        "records": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/TicketRecordDTO" }
        },
        "total_matched": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of matching incident records prior to the 20-record cap."
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0.0
        },
        "error_message": {
          "type": ["string", "null"]
        }
      }
    },
    "InventoryToolInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "type": ["integer", "null"],
          "description": "Numeric product/SKU primary key ID."
        },
        "sku": {
          "type": ["string", "null"],
          "description": "Exact alphanumeric SKU code (e.g., 'TF-1001')."
        },
        "search_query": {
          "type": ["string", "null"],
          "description": "Case-insensitive product name or SKU search term."
        },
        "low_stock_only": {
          "type": "boolean",
          "default": false,
          "description": "When true, filters to products where current stock <= min_threshold."
        },
        "limit": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 20,
          "description": "Maximum number of product stock records returned into agent state (hard cap: 20)."
        }
      }
    },
    "InventoryRecordDTO": {
      "type": "object",
      "required": [
        "id",
        "sku",
        "name",
        "description",
        "stock",
        "min_threshold",
        "is_low_stock"
      ],
      "properties": {
        "id": { "type": "integer" },
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "stock": { "type": "integer" },
        "min_threshold": { "type": "integer" },
        "is_low_stock": { "type": "boolean" },
        "warehouse_id": { "type": "string" }
      }
    },
    "InventoryToolOutput": {
      "type": "object",
      "required": [
        "status",
        "records",
        "total_matched",
        "latency_ms"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/ToolCallStatus" },
        "records": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/InventoryRecordDTO" }
        },
        "total_matched": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of matching product records prior to the 20-record cap."
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0.0
        },
        "error_message": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
