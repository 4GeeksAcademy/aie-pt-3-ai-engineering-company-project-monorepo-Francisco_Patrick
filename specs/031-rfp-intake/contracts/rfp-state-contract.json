{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RFPStateContract",
  "description": "Typed state passed across LangGraph nodes in the RFP Intake Pipeline",
  "type": "object",
  "required": [
    "ticket_id",
    "pdf_path",
    "markdown_content",
    "readability_scores",
    "status"
  ],
  "properties": {
    "ticket_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUID of the active intake ticket"
    },
    "pdf_path": {
      "type": "string",
      "description": "Filesystem path to raw uploaded PDF"
    },
    "markdown_content": {
      "type": "string",
      "description": "Converted markdown content of the document"
    },
    "readability_scores": {
      "type": "object",
      "required": [
        "flesch_reading_ease",
        "flesch_kincaid_grade",
        "reading_level_label",
        "word_count",
        "sentence_count"
      ],
      "properties": {
        "flesch_reading_ease": { "type": "number" },
        "flesch_kincaid_grade": { "type": "number" },
        "reading_level_label": { "type": "string" },
        "word_count": { "type": "integer" },
        "sentence_count": { "type": "integer" }
      }
    },
    "is_rfp": {
      "type": "boolean",
      "description": "Set by Classifier Agent: True if document is a valid customer proposal request"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Set by Classifier Agent when is_rfp is False"
    },
    "metadata": {
      "type": "object",
      "description": "Extracted by Orchestrator Agent",
      "required": [
        "client_name",
        "client_country",
        "currency",
        "services_requested",
        "departments_needed",
        "unsupported_services"
      ],
      "properties": {
        "client_name": { "type": "string" },
        "client_country": { "type": "string", "enum": ["US", "ES"] },
        "currency": { "type": "string", "enum": ["USD", "EUR"] },
        "services_requested": {
          "type": "array",
          "items": { "type": "string" }
        },
        "monthly_volume": { "type": ["integer", "null"] },
        "deadline": { "type": ["string", "null"] },
        "budget_range": { "type": ["string", "null"] },
        "departments_needed": {
          "type": "array",
          "items": { "type": "string", "enum": ["warehouse", "lastmile", "reverse"] }
        },
        "unsupported_services": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "department_sections": {
      "type": "object",
      "description": "Dictionary keyed by department_id with worker outputs",
      "properties": {
        "warehouse": { "$ref": "#/$defs/department_section" },
        "lastmile": { "$ref": "#/$defs/department_section" },
        "reverse": { "$ref": "#/$defs/department_section" }
      }
    },
    "synthesis": {
      "type": "object",
      "description": "Generated by Synthesizer Agent",
      "required": [
        "executive_summary",
        "flagged_contradictions",
        "key_questions_for_prospect",
        "internal_contacts"
      ],
      "properties": {
        "executive_summary": { "type": "string" },
        "flagged_contradictions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "key_questions_for_prospect": {
          "type": "array",
          "items": { "type": "string" }
        },
        "internal_contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "role", "department"],
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "department": { "type": "string" }
            }
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["analizando", "descartado", "analisis_completo"]
    },
    "error_message": {
      "type": ["string", "null"]
    }
  },
  "$defs": {
    "department_section": {
      "type": "object",
      "required": [
        "department_id",
        "department_name",
        "responsible_person",
        "key_aspects",
        "open_questions",
        "policy_warnings"
      ],
      "properties": {
        "department_id": {
          "type": "string",
          "enum": ["warehouse", "lastmile", "reverse"]
        },
        "department_name": { "type": "string" },
        "responsible_person": { "type": "string" },
        "key_aspects": { "type": "object" },
        "open_questions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "policy_warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}